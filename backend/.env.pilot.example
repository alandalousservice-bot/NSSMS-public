# ============================================================================
# PILOT / STAGING DEPLOYMENT TEMPLATE - ArenaRabita / NSSMS backend
#
# Copy to a real environment file on the deployment host. NEVER commit real
# credentials. NEVER reuse any value below as an actual secret.
#
# RULE: Never run demo seeds (seed:demo, seed:data, seed:national-accounts,
# seed:scoped-accounts) against a pilot or production database. Demo seed
# scripts are development-only tools.
# ============================================================================

# Must be "production" for any remotely accessible deployment (pilot, staging,
# production). Strict AUTH_SECRET / DATABASE_URL / CORS checks only pass with
# this value set explicitly.
NODE_ENV=production

# PostgreSQL connection string for the pilot database.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# REQUIRED in production mode. Generate at least 32 characters of entropy,
# e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Known placeholders/defaults are rejected at startup. Never log this value.
AUTH_SECRET=

# Explicit comma-separated list of browser origins allowed to call the API.
# "*" is rejected. The canonical variable is CORS_ALLOWED_ORIGINS;
# CORS_ORIGINS is accepted as an alias.
CORS_ALLOWED_ORIGINS=https://pilot.example.org
# CORS_ORIGINS=https://pilot.example.org

# Set to true ONLY when running behind a reverse proxy that sets X-Forwarded-*.
TRUST_PROXY=false

# Maximum accepted JSON body size in bytes (safe default: 1 MiB).
BODY_LIMIT_BYTES=1048576

# Per-request server timeout in milliseconds (safe default: 30000).
REQUEST_TIMEOUT_MS=30000

# Global rate limit (safe defaults below).
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=100
REGISTRATION_RATE_LIMIT_MAX=20

LOG_LEVEL=info
PORT=3000
